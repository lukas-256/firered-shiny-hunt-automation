# Copy this file to .env.local, replace the example values, then run:
# source .env.local

export SHINY_HUNT_PROFILE="snorlax"
export SHINY_HUNT_CAPTURE_DEVICE="0"
export SHINY_HUNT_SERIAL_PORT="/dev/cu.usbserial-CHANGE_ME"
export SHINY_HUNT_RESET_COUNTER_INITIAL="0"

# Leave empty to disable notifications. ntfy.sh topics are public to anyone
# who knows the topic name, so use a long random value and never commit it.
export SHINY_HUNT_NTFY_TOPIC=""
